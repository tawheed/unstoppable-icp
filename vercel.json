{
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/tam-sam-som-calculator.html", "destination": "/", "permanent": true },
    { "source": "/tam-sam-som-calculator", "destination": "/", "permanent": true },
    { "source": "/saas-marketing.html", "destination": "/", "permanent": true },
    { "source": "/saas-marketing", "destination": "/", "permanent": true },
    { "source": "/b2b-saas-lead-generation.html", "destination": "/", "permanent": true },
    { "source": "/b2b-saas-lead-generation", "destination": "/", "permanent": true },
    { "source": "/ltv-calculator.html", "destination": "/", "permanent": true },
    { "source": "/ltv-calculator", "destination": "/", "permanent": true },
    { "source": "/cac-payback-calculator.html", "destination": "/", "permanent": true },
    { "source": "/cac-payback-calculator", "destination": "/", "permanent": true },
    { "source": "/CLAUDE.md", "destination": "/", "permanent": true },
    { "source": "/DESIGN-GUIDE.md", "destination": "/", "permanent": true },
    { "source": "/tailwind.config.js", "destination": "/", "permanent": true },
    { "source": "/src/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
